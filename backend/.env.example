# Copia este archivo como .env y llena los valores de tu equipo.
# El .env NUNCA se sube a GitHub (está en el .gitignore).

NODE_ENV=development

# Puerto del backend. La web (puerto 4000) le manda las peticiones de /api aquí.
PORT=4001

# Conexión a PostgreSQL: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/espacio_corporativo

# Desde qué dirección puede llamar la web al backend
CORS_ORIGIN=http://localhost:4000

# Nivel de detalle de los logs: debug | info | warn | error
LOG_LEVEL=info

# ── Inicio de sesión ──
# Clave secreta para firmar las sesiones: mínimo 32 caracteres, distinta en cada ambiente.
# Para generar una:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_SECRETA_DE_32_O_MAS
# Minutos que dura el acceso (se renueva solo) y días que dura la sesión
ACCESO_MINUTOS=15
SESION_DIAS=7
# Bloqueo temporal tras intentos fallidos
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO=15
# true solo cuando la plataforma esté en HTTPS (producción)
COOKIE_SECURE=false
TRUST_PROXY=1

# ── Administrador inicial (lo crea npm run db:seed) ──
ADMIN_DOCUMENTO=
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=
ADMIN_CONTRASENA=
