{
  "name": "espacio-corporativo",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de comunicación interna de Servired y Multired",
  "workspaces": [
    "shared",
    "backend",
    "web"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace backend && npm run build --workspace web",
    "test": "npm run test --workspace backend",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend"
  },
  "engines": {
    "node": ">=20"
  }
}
